# Copy to ~/.config/mattermost-mcp/.env and chmod 600.
MATTERMOST_BASE_URL=https://mattermost.example.com

# Preferred: a Personal Access Token, or a browser session token (cookie MMAUTHTOKEN).
MATTERMOST_TOKEN=

# Fallback when there is no token: Mattermost login and password (email/password accounts only, not SSO).
MATTERMOST_LOGIN_ID=
MATTERMOST_PASSWORD=
# Only if MFA is enabled on the account.
MATTERMOST_MFA_TOKEN=

MATTERMOST_VERIFY_SSL=true
MATTERMOST_REQUEST_TIMEOUT_SEC=30
# Where download_file saves files; saving outside this directory is refused.
MATTERMOST_DOWNLOADS_DIR=~/Downloads/mattermost
# Largest file download_file will save, in MB.
MATTERMOST_MAX_DOWNLOAD_MB=100
# ":"-separated directories send_message may attach files from (default: home and the downloads dir).
# Hidden paths (~/.ssh, ~/.config, ...) are always refused.
MATTERMOST_UPLOAD_DIRS=

# Only for --http. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MATTERMOST_MCP_TOKEN=
MATTERMOST_MCP_HOST=127.0.0.1
MATTERMOST_MCP_PORT=8732
